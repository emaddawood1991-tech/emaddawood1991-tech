  {
   "id": "p12",
   "start": 65.809,
   "end": 68.634,
   "show": "To use it in Claude Code, add it with one command.",
   "speak": "To use it in Claude Code, add it with one command.",
   "map": null
  },
  {
   "id": "p13",
