   "end": 71.282,
   "show": "Claude Code checks the connection: connected.",
   "speak": "Claude Code checks the connection: connected.",
   "map": null
  },
  {
   "id": "p14",
   "start": 71.402,
   "end": 75.139,
   "show": "MCP is the standard plug between AI apps and your tools.",
