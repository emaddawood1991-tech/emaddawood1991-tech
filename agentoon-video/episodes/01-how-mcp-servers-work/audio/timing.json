 "phrases": [
  {
   "id": "p0",
   "start": 0.15,
   "end": 5.076,
   "show": "A tiny server just counted the lines in a real file. That is MCP at work.",
   "speak": "A tiny server just counted the lines in a real file. That is MCP at work.",
   "map": null
  },
  {
   "id": "p1",
   "start": 5.196,
   "end": 11.846,
   "show": "Without MCP, every AI app needs custom code for every tool, file, and database it touches.",
   "speak": "Without MCP, every AI app needs custom code for every tool, file, and database it touches.",
   "map": null
  },
  {
   "id": "p2",
   "start": 11.966,
   "end": 15.805,
   "show": "Four apps and four tools mean sixteen custom integrations.",
   "speak": "Four apps and four tools mean sixteen custom integrations.",
   "map": null
  },
  {
   "id": "p3",
   "start": 15.925,
   "end": 21.125,
   "show": "MCP, the Model Context Protocol, is an open standard that fixes that.",
   "speak": "MCP, the Model Context Protocol, is an open standard that fixes that.",
   "map": null
  },
  {
   "id": "p4",
   "start": 21.245,
   "end": 26.117,
   "show": "Your AI app is the host, and it runs one client for each server it connects to.",
   "speak": "Your AI app is the host, and it runs one client for each server it connects to.",
   "map": null
  },
  {
   "id": "p5",
   "start": 26.237,
   "end": 32.908,
   "show": "A server offers three things: tools the model can call, resources it can read, and prompts you can reuse.",
   "speak": "A server offers three things: tools the model can call, resources it can read, and prompts you can reuse.",
   "map": null
  },
  {
   "id": "p6",
   "start": 33.028,
   "end": 41.245,
   "show": "Messages are JSON-RPC, sent over standard input and output locally, or over HTTP for remote servers.",
   "speak": "Messages are JSON-RPC, sent over standard input and output locally, or over HTTP for remote servers.",
   "map": null
  },
  {
   "id": "p7",
   "start": 41.365,
   "end": 48.101,
   "show": "Let's watch it happen with a real server. It is twenty-four lines, built with the official TypeScript SDK.",
   "speak": "Let's watch it happen with a real server. It is twenty-four lines, built with the official TypeScript SDK.",
   "map": null
  },
  {
   "id": "p8",
   "start": 48.221,
   "end": 52.125,
   "show": "The client starts by asking who the server is and what it supports.",
   "speak": "The client starts by asking who the server is and what it supports.",
   "map": null
  },
  {
   "id": "p9",
   "start": 52.245,
   "end": 55.971,
   "show": "Then it asks for the tools. The server lists one: count lines.",
   "speak": "Then it asks for the tools. The server lists one: count lines.",
   "map": null
  },
  {
   "id": "p10",
   "start": 56.091,
   "end": 62.847,
   "show": "Now the call. Count the lines in notes.txt. The server reads the file, and answers: eleven lines.",
   "speak": "Now the call. Count the lines in notes dot text. The server reads the file, and answers: eleven lines.",
