 "phrases": [
  {
   "id": "p1",
   "start": 0.15,
   "end": 2.978,
   "show": "Think Git and GitHub are the same thing? They're not!",
   "speak": "Think Git and GitHub are the same thing? They're not!",
   "map": null
  },
  {
   "id": "p2",
   "start": 3.898,
   "end": 9.715,
   "show": "Imagine you're building a website. You write some code, change the design, and add new features.",
   "speak": "Imagine you're building a website. You write some code, change the design, and add new features.",
   "map": null
  },
  {
   "id": "p3",
   "start": 10.635,
   "end": 14.853,
   "show": "Git keeps track of those changes, so you have a history of your project.",
   "speak": "Git keeps track of those changes, so you have a history of your project.",
   "map": null
  },
  {
   "id": "p4",
   "start": 15.773,
   "end": 20.258,
   "show": "If something goes wrong, Git helps you find and recover an earlier version.",
   "speak": "If something goes wrong, Git helps you find and recover an earlier version.",
   "map": null
  },
  {
   "id": "p5",
   "start": 20.978,
   "end": 26.896,
   "show": "GitHub is different. It's an online platform where you can store and share Git repositories.",
   "speak": "GitHub is different. It's an online platform where you can store and share Git repositories.",
   "map": null
  },
  {
   "id": "p6",
   "start": 27.816,
   "end": 33.261,
   "show": "Use git push to send your commits to GitHub, and git pull to bring remote changes back.",
   "speak": "Use git push to send your commits to GitHub, and git pull to bring remote changes back.",
   "map": null
  },
  {
   "id": "p7",
   "start": 34.181,
   "end": 38.504,
   "show": "With git clone, you can copy a repository onto another computer.",
   "speak": "With git clone, you can copy a repository onto another computer.",
   "map": null
  },
  {
   "id": "p8",
   "start": 39.224,
   "end": 43.895,
   "show": "And git add and git commit let you stage and save a snapshot of your changes.",
   "speak": "And git add and git commit let you stage and save a snapshot of your changes.",
   "map": null
  },
  {
   "id": "p9",
   "start": 44.815,
   "end": 51.147,
   "show": "So remember: Git tracks your project's history. GitHub hosts and shares repositories online.",
   "speak": "So remember: Git tracks your project's history. GitHub hosts and shares repositories online.",
   "map": null
  },
  {
   "id": "p10",
   "start": 51.767,
   "end": 53.919,
   "show": "Follow Agentoon.ai for more!",
