<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no" />
  <title>Al Mutarid Mall · مول المطرد</title>
  <style>
    :root { --gold:#e0a84a; --ink:#120b07; --cream:#fff3dc; }
    * { box-sizing:border-box; margin:0; padding:0; }
    html,body { height:100%; background:#0b0705; overflow:hidden; font-family:"Segoe UI",Tahoma,sans-serif; color:var(--cream); }
    canvas { display:block; width:100vw; height:100vh; touch-action:none; cursor:grab; }
    canvas.hover { cursor:pointer; }
    .brand { position:fixed; top:14px; left:16px; padding:10px 16px; border:1px solid #e0a84a66; border-radius:14px; background:#120b07cc; backdrop-filter:blur(6px); }
    .brand b { letter-spacing:.22em; font-size:15px; color:var(--gold); }
    .brand span { display:block; font-size:13px; opacity:.8; margin-top:2px; }
    .dir { position:fixed; top:14px; right:16px; bottom:56px; overflow-y:auto; display:flex; flex-direction:column; gap:6px; width:min(44vw,200px); padding-right:2px; scrollbar-width:thin; }
    .dir .sec { margin-top:6px; font-size:11px; letter-spacing:.18em; text-transform:uppercase; color:var(--gold); }
    .dir button { text-align:left; font:inherit; font-size:13px; color:var(--cream); background:#120b07cc; border:1px solid #e0a84a55; border-left-width:5px; border-radius:10px; padding:7px 12px; cursor:pointer; backdrop-filter:blur(6px); }
    .dir button:hover { background:#2a1a0f; }
    .help { position:fixed; bottom:14px; left:50%; transform:translateX(-50%); font-size:12.5px; opacity:.85; padding:7px 14px; border-radius:999px; background:#120b07cc; border:1px solid #e0a84a44; white-space:nowrap; }
    .tip { position:fixed; pointer-events:none; padding:6px 11px; border-radius:8px; background:#120b07ee; border:1px solid var(--gold); font-size:13px; transform:translate(14px,14px); display:none; }
    .card { position:fixed; inset:0; display:none; align-items:center; justify-content:center; background:#000a; z-index:5; }
    .card.open { display:flex; }
    .card .box { width:min(92vw,380px); padding:22px; border-radius:18px; background:#17100b; border:2px solid var(--c,#e0a84a); box-shadow:0 0 40px var(--c,#e0a84a)55; text-align:center; }
    .card h2 { font-size:24px; }
    .card .ar { font-size:20px; margin-top:2px; color:var(--c,#e0a84a); }
    .card .cat { font-size:12.5px; opacity:.7; margin:8px 0 10px; letter-spacing:.06em; text-transform:uppercase; }
    .card p { font-size:14px; line-height:1.5; opacity:.9; }
    .card .note { margin-top:10px; font-size:11.5px; color:#ffb36b; }
    .card .row { display:flex; gap:10px; margin-top:16px; }
    .card .row > * { flex:1; padding:12px; border-radius:12px; font:inherit; font-weight:600; cursor:pointer; text-decoration:none; text-align:center; }
    .card .go { background:var(--c,#e0a84a); color:#120b07; border:0; }
    .card .close { background:transparent; color:var(--cream); border:1px solid #fff4; }
    .joy { position:fixed; left:22px; bottom:28px; width:120px; height:120px; border-radius:50%; background:#fff1; border:1px solid #fff4; display:none; touch-action:none; }
    .joy i { position:absolute; left:40px; top:40px; width:40px; height:40px; border-radius:50%; background:#e0a84acc; }
    @media (pointer:coarse) { .joy { display:block; } .help { display:none; } }
  </style>
  
</head>
<body>
  <canvas id="c"></canvas>
  <div class="brand"><b>AL MUTARID MALL</b><span>مول المطرد · العين</span></div>
  <div class="dir" id="dir"></div>
  <div class="help">W A S D / arrows to walk · drag to look · click a shop to open it</div>
  <div class="tip" id="tip"></div>
  <div class="joy" id="joy"><i></i></div>
  <div class="card" id="card">
    <div class="box" id="box">
      <h2 id="cName"></h2><div class="ar" id="cAr"></div>
      <div class="cat" id="cCat"></div><p id="cDesc"></p>
      <div class="note" id="cNote"></div>
      <div class="row"><a class="go" id="cGo" target="_blank" rel="noopener">Open website &amp; order</a><button class="close" id="cClose">Keep walking</button></div>
    </div>
  </div>
