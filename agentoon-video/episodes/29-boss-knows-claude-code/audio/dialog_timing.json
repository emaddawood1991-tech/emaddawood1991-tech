 "lines": [
  {
   "id": "l01",
   "who": "A",
   "scene": "hook",
   "show": "Claude! My boss thinks I didn't write my own code!",
   "start": 1.95,
   "end": 4.354
  },
  {
   "id": "l02",
   "who": "C",
   "scene": "hook",
   "show": "Oh? Did something break?",
   "start": 4.654,
   "end": 6.189
  },
  {
   "id": "l03",
   "who": "A",
   "scene": "suspicious",
   "show": "No! That's the problem. Everything works!",
   "start": 6.839,
   "end": 8.831
  },
  {
   "id": "l04",
   "who": "C",
   "scene": "suspicious",
   "show": "That's a pretty serious accusation.",
   "start": 9.131,
   "end": 11.215
  },
  {
   "id": "l05",
   "who": "A",
   "scene": "style",
   "show": "Can you make it look a little more like my usual code?",
   "start": 11.715,
   "end": 14.291
  },
  {
   "id": "l06",
   "who": "C",
   "scene": "style",
   "show": "Your usual code?",
   "start": 14.941,
   "end": 16.209
  },
  {
   "id": "l07",
   "who": "A",
   "scene": "style",
   "show": "Yeah. You know... my personal coding style.",
   "start": 16.509,
   "end": 18.968
  },
  {
   "id": "l08",
   "who": "C",
   "scene": "style",
   "show": "I've seen your code.",
   "start": 19.268,
   "end": 20.465
  },
  {
   "id": "l09",
   "who": "C",
   "scene": "bug",
   "show": "Well, your old login button needed two clicks before it actually worked.",
   "start": 22.365,
   "end": 26.881
  },
  {
   "id": "l10",
   "who": "A",
   "scene": "bug",
   "show": "Wait. It already did that!",
   "start": 27.481,
   "end": 28.769
  },
  {
   "id": "l11",
   "who": "C",
   "scene": "bug",
   "show": "I know. I fixed it earlier.",
   "start": 29.169,
   "end": 30.827
  },
  {
   "id": "l12",
   "who": "A",
   "scene": "idea",
   "show": "So technically, you could bring the old bug back?",
   "start": 32.927,
   "end": 35.366
  },
  {
   "id": "l13",
   "who": "C",
   "scene": "idea",
   "show": "Technically, yes. Professionally, that's a terrible idea.",
   "start": 36.166,
   "end": 39.939
  },
  {
   "id": "l14",
   "who": "A",
   "scene": "manager",
   "show": "Claude... we have another problem.",
   "start": 43.839,
   "end": 45.568
  },
  {
   "id": "l15",
   "who": "C",
   "scene": "manager",
   "show": "Don't worry. I'll explain the code. But you're going to learn it this time.",
   "start": 46.768,
   "end": 51.314
  },
  {
   "id": "l16",
   "who": "C",
   "scene": "joke",
   "show": "So... should I bring back the old bug?",
   "start": 54.814,
   "end": 57.053
  },
  {
   "id": "l17",
   "who": "A",
   "scene": "joke",
   "show": "Don't touch it!",
