 "phrases": [
  {
   "id": "p1",
   "scene": "s1",
   "start": 0.2,
   "end": 5.1,
   "show": "Before you pay for another AI subscription, check out these six open-source alternatives!",
   "speak": "Before you pay for another AI subscription, check out these six open-source alternatives!"
  },
  {
   "id": "p2",
   "scene": "s2",
   "start": 5.44,
   "end": 11.43,
   "show": "First, Open Generative AI, an open-source studio for working with image and video generation models.",
   "speak": "First, Open Generative AI, an open-source studio for working with image and video generation models."
  },
  {
   "id": "p2b",
   "scene": "s2",
   "start": 11.71,
   "end": 14.651,
   "show": "It lists more than 600 models across 14 studios.",
   "speak": "It lists more than six hundred models across fourteen studios."
  },
  {
   "id": "p2c",
   "scene": "s2",
   "start": 14.931,
   "end": 20.521,
   "show": "Cloud models go through MuAPI and need an API key, so costs may apply. Local models don't.",
   "speak": "Cloud models go through Muapi and need an API key, so costs may apply. Local models don't."
  },
  {
   "id": "p3",
   "scene": "s3",
   "start": 20.861,
   "end": 28.359,
   "show": "Next, OpenSEO, an open-source alternative to Semrush and Ahrefs, for keyword research, rank tracking, backlinks, and site audits.",
   "speak": "Next, OpenSEO, an open-source alternative to Semrush and Ahrefs, for keyword research, rank tracking, backlinks, and site audits."
  },
  {
   "id": "p3b",
   "scene": "s3",
   "start": 28.639,
   "end": 31.835,
   "show": "You bring your own DataForSEO key, and pay per request.",
   "speak": "You bring your own DataForSEO key, and pay per request."
  },
  {
   "id": "p4",
   "scene": "s4",
   "start": 32.175,
   "end": 39.888,
   "show": "Need a Notion-style workspace? AppFlowy brings documents, databases, and project organization into an open-source environment.",
   "speak": "Need a Notion-style workspace? AppFlowy brings documents, databases, and project organization into an open-source environment."
  },
  {
   "id": "p4b",
   "scene": "s4",
   "start": 40.168,
   "end": 43.164,
   "show": "It's AGPL licensed, with a self-hosting guide.",
   "speak": "It's AGPL licensed, with a self-hosting guide."
  },
  {
   "id": "p5",
   "scene": "s5",
   "start": 43.504,
   "end": 48.316,
   "show": "OpenWhispr turns speech into text, with options for local transcription and cloud models.",
   "speak": "OpenWhispr turns speech into text, with options for local transcription and cloud models."
  },
  {
   "id": "p5b",
   "scene": "s5",
   "start": 48.596,
   "end": 52.97,
   "show": "Local models keep your audio on your device. It's an alternative to Wispr Flow.",
   "speak": "Local models keep your audio on your device. It's an alternative to Wispr Flow."
  },
  {
   "id": "p6",
   "scene": "s6",
   "start": 53.31,
   "end": 60.802,
   "show": "Cal.diy gives self-hosting enthusiasts an open-source scheduling system, but it's not recommended for production business use.",
   "speak": "Cal.diy gives self-hosting enthusiasts an open-source scheduling system, but it's not recommended for production business use."
  },
  {
   "id": "p6b",
   "scene": "s6",
   "start": 61.082,
   "end": 64.516,
   "show": "It's the community edition of Cal.com, with no hosted version.",
   "speak": "It's the community edition of Cal.com, with no hosted version."
  },
  {
   "id": "p7",
   "scene": "s7",
   "start": 64.856,
   "end": 70.371,
   "show": "Cap is a screen-recording alternative to Loom, built for capturing and sharing what's happening on your screen.",
   "speak": "Cap is a screen-recording alternative to Loom, built for capturing and sharing what's happening on your screen."
  },
  {
   "id": "p7b",
   "scene": "s7",
   "start": 70.651,
   "end": 73.362,
   "show": "Instant Mode gives you a share link as soon as you stop.",
   "speak": "Instant Mode gives you a share link as soon as you stop."
  },
  {
   "id": "p8",
   "scene": "s8",
   "start": 73.702,
   "end": 80.338,
   "show": "Open source doesn't always mean zero cost. Hosting, infrastructure, or AI services may still cost money.",
   "speak": "Open source doesn't always mean zero cost. Hosting, infrastructure, or AI services may still cost money."
  },
  {
   "id": "p9",
   "scene": "s9",
   "start": 80.678,
   "end": 86.647,
   "show": "Which one would you try first? Save this video and follow Agentoon.ai for more useful AI tools!",
   "speak": "Which one would you try first? Save this video and follow Agentoon dot A I for more useful AI tools!"
  }
