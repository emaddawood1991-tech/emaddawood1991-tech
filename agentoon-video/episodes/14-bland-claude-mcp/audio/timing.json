 "phrases": [
  {
   "id": "p1",
   "scene": "s1",
   "start": 0.2,
   "end": 4.993,
   "show": "What if Claude could actually call your phone? Here's how to connect it using MCP.",
   "speak": "What if Claude could actually call your phone? Here's how to connect it using MCP."
  },
  {
   "id": "p2",
   "scene": "s2",
   "start": 5.393,
   "end": 11.459,
   "show": "First, open Bland AI and create an account. It's a platform for AI-powered voice calls.",
   "speak": "First, open Bland AI and create an account. It's a platform for AI-powered voice calls."
  },
  {
   "id": "p2b",
   "scene": "s2",
   "start": 11.759,
   "end": 14.874,
   "show": "You can sign in with a phone number, Google, or SSO.",
   "speak": "You can sign in with a phone number, Google, or SSO."
  },
  {
   "id": "p3",
   "scene": "s3",
   "start": 15.274,
   "end": 20.948,
   "show": "Next, open Bland's MCP integration page and copy its official server URL.",
   "speak": "Next, open Bland's MCP integration page and copy its official server URL."
  },
  {
   "id": "p3b",
   "scene": "s3",
   "start": 21.248,
   "end": 24.082,
   "show": "It's a hosted server, so there's nothing to install.",
   "speak": "It's a hosted server, so there's nothing to install."
  },
  {
   "id": "p4",
   "scene": "s4",
   "start": 24.482,
   "end": 32.916,
   "show": "Now open Claude, go to Customize, then Connectors. Add a custom connector, name it Bland AI, and paste the MCP URL.",
   "speak": "Now open Claude, go to Customize, then Connectors. Add a custom connector, name it Bland AI, and paste the MCP URL."
  },
  {
   "id": "p4b",
   "scene": "s4",
   "start": 33.216,
   "end": 37.362,
   "show": "Claude shows its authentication settings. Review them, then continue.",
   "speak": "Claude shows its authentication settings. Review them, then continue."
  },
  {
   "id": "p5",
   "scene": "s5",
   "start": 37.762,
   "end": 45.324,
   "show": "Sign in to Bland, choose your organization, and review the permissions. Now Claude can access Bland's available tools.",
   "speak": "Sign in to Bland, choose your organization, and review the permissions. Now Claude can access Bland's available tools."
  },
  {
   "id": "p5b",
   "scene": "s5",
   "start": 45.624,
   "end": 49.604,
   "show": "For read-only access, uncheck the permission to change your agents.",
   "speak": "For read-only access, uncheck the permission to change your agents."
  },
  {
   "id": "p5c",
   "scene": "s5",
   "start": 49.904,
   "end": 53.836,
   "show": "Prefer Claude Code? Add the server with one command, then log in.",
   "speak": "Prefer Claude Code? Add the server with one command, then log in."
  },
  {
   "id": "p6",
   "scene": "s6",
   "start": 54.236,
   "end": 59.056,
   "show": "Let's test it. Ask Claude to list your Bland agents. If it answers, you're connected.",
   "speak": "Let's test it. Ask Claude to list your Bland agents. If it answers, you're connected."
  },
  {
   "id": "p6b",
   "scene": "s6",
   "start": 59.356,
   "end": 63.898,
   "show": "Placing a real call needs your approval, your own number, and Bland credits.",
   "speak": "Placing a real call needs your approval, your own number, and Bland credits."
  },
  {
   "id": "p7",
   "scene": "s7",
   "start": 64.298,
   "end": 72.609,
   "show": "You can use this for reminders, confirmations, and other approved phone tasks. Calling features may require credits or a paid plan.",
   "speak": "You can use this for reminders, confirmations, and other approved phone tasks. Calling features may require credits or a paid plan."
  },
  {
   "id": "p8",
   "scene": "s8",
