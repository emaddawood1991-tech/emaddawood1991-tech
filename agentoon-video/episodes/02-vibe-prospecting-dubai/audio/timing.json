 "phrases": [
  {
   "id": "p0",
   "start": 0.15,
   "end": 3.65,
   "show": "What if Claude Code could find your next hundred potential clients?",
   "speak": "What if Claude Code could find your next hundred potential clients?",
   "map": null
  },
  {
   "id": "p1",
   "start": 3.77,
   "end": 12.187,
   "show": "This is Vibe Prospecting, an open plugin from Explorium that connects Claude Code to a live database of companies and professionals.",
   "speak": "This is Vibe Prospecting, an open plugin from Explorium that connects Claude Code to a live database of companies and professionals.",
   "map": null
  },
  {
   "id": "p2",
   "start": 12.307,
   "end": 17.493,
   "show": "Everything lives in an open GitHub repository, under the MIT license.",
   "speak": "Everything lives in an open GitHub repository, under the MIT license.",
   "map": null
  },
  {
   "id": "p3",
   "start": 17.613,
   "end": 20.462,
   "show": "Install it with one command inside Claude Code.",
   "speak": "Install it with one command inside Claude Code.",
   "map": null
  },
  {
   "id": "p4",
   "start": 20.582,
   "end": 24.674,
   "show": "Then sign in with your Vibe Prospecting account, and you're ready to search.",
   "speak": "Then sign in with your Vibe Prospecting account, and you're ready to search.",
   "map": null
  },
  {
   "id": "p5",
   "start": 24.794,
   "end": 32.128,
   "show": "Now give Claude a mission: real estate agencies in Dubai that sell apartments, or advise property investors.",
   "speak": "Now give Claude a mission: real estate agencies in Dubai that sell apartments, or advise property investors.",
   "map": null
  },
  {
   "id": "p6",
   "start": 32.248,
   "end": 36.314,
   "show": "That becomes a precise search: location, industry, and company type.",
   "speak": "That becomes a precise search: location, industry, and company type.",
   "map": null
  },
  {
   "id": "p7",
   "start": 36.434,
   "end": 41.346,
   "show": "Ask for a sample first, and for any credit requirements before anything is processed.",
   "speak": "Ask for a sample first, and for any credit requirements before anything is processed.",
   "map": null
  },
  {
   "id": "p8",
   "start": 41.466,
   "end": 47.375,
   "show": "Behind the scenes, the plugin queries Vibe Prospecting's business database, not the open web.",
   "speak": "Behind the scenes, the plugin queries Vibe Prospecting's business database, not the open web.",
   "map": null
  },
  {
   "id": "p9",
   "start": 47.495,
   "end": 53.648,
   "show": "It checks your filters, counts the matches, then runs the whole workflow on a sample of five companies.",
   "speak": "It checks your filters, counts the matches, then runs the whole workflow on a sample of five companies.",
   "map": null
  },
  {
   "id": "p10",
   "start": 53.768,
   "end": 57.274,
   "show": "You review that sample, and decide whether to approve a full run.",
   "speak": "You review that sample, and decide whether to approve a full run.",
   "map": null
  },
  {
   "id": "p11",
   "start": 57.394,
   "end": 67.056,
   "show": "Next comes enrichment: decision-makers by role and seniority, job titles, company domains, and professional contact details where they exist.",
   "speak": "Next comes enrichment: decision-makers by role and seniority, job titles, company domains, and professional contact details where they exist.",
   "map": null
  },
  {
   "id": "p12",
   "start": 67.176,
   "end": 69.977,
   "show": "Where they don't, the field simply says not available.",
   "speak": "Where they don't, the field simply says not available.",
   "map": null
  },
  {
   "id": "p13",
   "start": 70.097,
   "end": 76.383,
   "show": "Then the results are saved as a CSV file in your folder, ready for a spreadsheet or your sales team.",
   "speak": "Then the results are saved as a CSV file in your folder, ready for a spreadsheet or your sales team.",
   "map": null
  },
  {
   "id": "p14",
   "start": 76.503,
   "end": 80.97,
   "show": "The final count is whatever the database returns. Not always a hundred.",
   "speak": "The final count is whatever the database returns. Not always a hundred.",
   "map": null
  },
  {
   "id": "p15",
   "start": 81.09,
   "end": 87.178,
   "show": "Instead of starting every search from scratch, you get a structured list of companies to research and qualify.",
   "speak": "Instead of starting every search from scratch, you get a structured list of companies to research and qualify.",
   "map": null
  },
  {
   "id": "p16",
   "start": 87.298,
   "end": 90.408,
   "show": "Find companies. Discover contacts. Export leads.",
   "speak": "Find companies. Discover contacts. Export leads.",
   "map": null
  },
  {
   "id": "p17",
   "start": 90.528,
   "end": 93.301,
   "show": "It builds the list. Reaching out is still up to you.",
   "speak": "It builds the list. Reaching out is still up to you.",
   "map": null
  },
  {
   "id": "p18",
   "start": 93.421,
   "end": 95.604,
   "show": "Would you use this to find your next clients?",
   "speak": "Would you use this to find your next clients?",
