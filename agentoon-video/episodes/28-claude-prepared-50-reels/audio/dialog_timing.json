{
 "total": 80.144,
 "lines": [
  {
   "id": "l01",
   "who": "A",
   "scene": "hook",
   "show": "Hey, Claude! What have you been doing while I was at the gym?",
   "start": 1.45,
   "end": 4.288
  },
  {
   "id": "l02",
   "who": "C",
   "scene": "hook",
   "show": "Working on your next 50 Instagram Reels.",
   "start": 4.568,
   "end": 7.229
  },
  {
   "id": "l03",
   "who": "A",
   "scene": "surprise",
   "show": "Fifty?! I haven't even finished editing yesterday's video!",
   "start": 8.009,
   "end": 10.946
  },
  {
   "id": "l04",
   "who": "C",
   "scene": "surprise",
   "show": "That's why we're building a better workflow.",
   "start": 11.226,
   "end": 13.477
  },
  {
   "id": "l05",
   "who": "A",
   "scene": "audience",
   "show": "But how do you know what people actually want to watch?",
   "start": 13.757,
   "end": 16.247
  },
  {
   "id": "l06",
   "who": "C",
   "scene": "audience",
   "show": "Before creating anything, I research your audience, study successful content, and identify the problems your viewers want solved.",
   "start": 16.527,
   "end": 25.663
  },
  {
   "id": "l07",
   "who": "A",
   "scene": "content",
   "show": "So you're not just generating random videos?",
   "start": 26.193,
   "end": 28.483
  },
  {
   "id": "l08",
   "who": "C",
   "scene": "content",
   "show": "Exactly! I turn the research into hooks, scripts, visual concepts and captions that match your audience.",
   "start": 28.763,
   "end": 35.752
  },
  {
   "id": "l09",
   "who": "A",
   "scene": "code",
   "show": "But how do you create the videos?",
   "start": 36.032,
   "end": 37.529
  },
  {
   "id": "l10",
   "who": "C",
   "scene": "code",
   "show": "With Claude Code, reusable components and tools like Remotion, we can create video layouts, animations and captions programmatically.",
   "start": 37.809,
   "end": 47.398
  },
  {
   "id": "l11",
   "who": "A",
   "scene": "batch",
   "show": "And we can use that workflow for 50 different videos?",
   "start": 47.928,
   "end": 50.588
  },
  {
   "id": "l12",
   "who": "C",
   "scene": "batch",
   "show": "Yes, with reusable templates and the right production tools. Each video can have its own subject, visuals and script.",
   "start": 50.868,
   "end": 58.793
  },
  {
   "id": "l13",
   "who": "A",
   "scene": "approval",
   "show": "So everything gets posted automatically?",
   "start": 59.323,
   "end": 61.414
  },
  {
   "id": "l14",
   "who": "C",
   "scene": "approval",
   "show": "Not without your approval! We review the videos, check the facts and make sure every post represents your brand.",
   "start": 62.094,
   "end": 68.967
  },
  {
   "id": "l15",
   "who": "A",
   "scene": "closing",
   "show": "50 Reels? Maybe I should go to the gym more often!",
   "start": 69.497,
   "end": 72.524
  },
  {
   "id": "l16",
   "who": "C",
   "scene": "closing",
   "show": "Only after you approve the first one!",
   "start": 72.804,
   "end": 74.971
  },
  {
   "id": "l17",
   "who": "A",
   "scene": "closing",
   "show": "Save this video if you want to build your own AI content production system.",
   "start": 75.251,
   "end": 79.364
  }
 ],
