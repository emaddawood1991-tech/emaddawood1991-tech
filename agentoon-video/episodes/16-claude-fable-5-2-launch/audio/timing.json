 "phrases": [
  {
   "id": "p1",
   "scene": "s1",
   "start": 0.2,
   "end": 5.634,
   "show": "Claude Fable 5.2 is here, and Anthropic is showing what AI can build beyond the chat window.",
   "speak": "Claude Fable 5.2 is here, and Anthropic is showing what AI can build beyond the chat window."
  },
  {
   "id": "p2",
   "scene": "s2",
   "start": 5.954,
   "end": 12.942,
   "show": "Announced November 9th, Fable 5.2 is built for demanding coding, reasoning, and long-running technical projects.",
   "speak": "Announced November ninth, Fable 5.2 is built for demanding coding, reasoning, and long-running technical projects."
  },
  {
   "id": "p2b",
   "scene": "s2",
   "start": 13.222,
   "end": 18.969,
   "show": "Anthropic says it generates output up to 30% faster than Fable 5.1, at a lower price.",
   "speak": "Anthropic says it generates output up to thirty percent faster than Fable 5.1, at a lower price."
  },
  {
   "id": "p3",
   "scene": "s3",
   "start": 19.289,
   "end": 27.794,
   "show": "In one experiment, Fable coordinated more than a thousand AI agents over eight days to build a prototype operating system that boots on a laptop.",
   "speak": "In one experiment, Fable coordinated more than a thousand AI agents over eight days to build a prototype operating system that boots on a laptop."
  },
  {
   "id": "p3b",
   "scene": "s3",
   "start": 28.074,
   "end": 32.489,
   "show": "It started from an empty folder, and wrote, tested, and reviewed code around the clock.",
   "speak": "It started from an empty folder, and wrote, tested, and reviewed code around the clock."
  },
  {
   "id": "p4",
   "scene": "s4",
   "start": 32.809,
   "end": 41.383,
   "show": "Anthropic also demonstrated Fable controlling robots through physical tasks, like solving a puzzle cube, unscrewing a bottle cap, and drawing a picture.",
   "speak": "Anthropic also demonstrated Fable controlling robots through physical tasks, like solving a puzzle cube, unscrewing a bottle cap, and drawing a picture."
  },
  {
   "id": "p5",
   "scene": "s5",
   "start": 41.703,
   "end": 48.294,
   "show": "And for developers, the exciting part is bringing stronger reasoning and engineering capabilities into real coding workflows.",
   "speak": "And for developers, the exciting part is bringing stronger reasoning and engineering capabilities into real coding workflows."
  },
  {
   "id": "p5b",
   "scene": "s5",
   "start": 48.575,
   "end": 54.209,
   "show": "Here is a real Claude Code run on Fable 5.2. It writes a dashboard, then runs its own tests.",
   "speak": "Here is a real Claude Code run on Fable 5.2. It writes a dashboard, then runs its own tests."
  },
  {
   "id": "p6",
   "scene": "s6",
   "start": 54.529,
   "end": 63.042,
   "show": "Fable 5.2 supports a 1M-token context window, and is designed for complex projects involving multiple steps, tools, and agents.",
   "speak": "Fable 5.2 supports a million-token context window, and is designed for complex projects involving multiple steps, tools, and agents."
  },
  {
   "id": "p6b",
   "scene": "s6",
   "start": 63.322,
   "end": 68.76,
   "show": "Mythos 5.2 is the same underlying model, with fewer safeguards, for verified programs.",
   "speak": "Mythos 5.2 is the same underlying model, with fewer safeguards, for verified programs."
  },
  {
   "id": "p7",
   "scene": "s7",
   "start": 69.08,
   "end": 76.202,
   "show": "To try it, open Claude or Claude Code, check your available models, and select Fable 5.2 if your account includes access.",
   "speak": "To try it, open Claude or Claude Code, check your available models, and select Fable 5.2 if your account includes access."
  },
  {
   "id": "p8",
   "scene": "s8",
   "start": 76.522,
   "end": 87.363,
   "show": "From software engineering to robotics, Fable 5.2 shows how far AI agents are progressing. Follow Agentoon.ai for real demos and practical AI tutorials.",
   "speak": "From software engineering to robotics, Fable 5.2 shows how far AI agents are progressing. Follow Agentoon dot A I for real demos and practical A I tutorials."
  }
