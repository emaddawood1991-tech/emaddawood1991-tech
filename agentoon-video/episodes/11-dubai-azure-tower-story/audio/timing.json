 "phrases": [
  {
   "id": "p1",
   "start": 0.15,
   "end": 5.917,
   "show": "I built this 50-floor Dubai skyscraper concept with AI. Here is how it really happened.",
   "speak": "I built this fifty-floor Dubai skyscraper concept with AI. Here is how it really happened.",
   "map": null
  },
  {
   "id": "p2",
   "start": 6.737,
   "end": 15.107,
   "show": "It started with an idea. A twisting glass tower on the Dubai coast. A fictional site, inspired by Jumeirah. Not a real plot.",
   "speak": "It started with an idea. A twisting glass tower on the Dubai coast. A fictional site, inspired by Jumeirah. Not a real plot.",
   "map": null
  },
  {
   "id": "p3",
   "start": 15.827,
   "end": 21.781,
   "show": "Then I briefed Claude Code. 50 floors. A glass skin. Landscaping. And real interiors.",
   "speak": "Then I briefed Claude Code. Fifty floors. A glass skin. Landscaping. And real interiors.",
   "map": null
  },
  {
   "id": "p4",
   "start": 22.501,
   "end": 33.187,
   "show": "Claude Code wrote the project as Python scripts for Blender. The height, the 96-degree twist, even the 72 bronze fins, are just numbers in a file.",
   "speak": "Claude Code wrote the project as Python scripts for Blender. The height, the ninety-six degree twist, even the seventy-two bronze fins, are just numbers in a file.",
   "map": null
  },
  {
   "id": "p5",
   "start": 33.907,
   "end": 41.525,
   "show": "Run the build, and in under a second Blender creates the whole scene. More than 1,800 objects, with no manual modeling.",
   "speak": "Run the build, and in under a second Blender creates the whole scene. More than eighteen hundred objects, with no manual modeling.",
   "map": null
  },
  {
   "id": "p6",
   "start": 42.245,
   "end": 48.987,
   "show": "Then the cameras take over. A glass facade that twists as you rise. Palm trees. A grand arrival court.",
   "speak": "Then the cameras take over. A glass facade that twists as you rise. Palm trees. A grand arrival court.",
   "map": null
  },
  {
   "id": "p7",
   "start": 49.707,
   "end": 56.765,
   "show": "And the same tower, inside. A lobby. An office floor. An apartment. And a duplex penthouse with a feature stair.",
   "speak": "And the same tower, inside. A lobby. An office floor. An apartment. And a duplex penthouse with a feature stair.",
   "map": null
  },
  {
   "id": "p8",
   "start": 57.485,
   "end": 67.684,
   "show": "By my own count, the first concept took about 30 minutes of prompting. Rendering the film took a few hours. And it is only a concept. Not approved. Not built.",
   "speak": "By my own count, the first concept took about thirty minutes of prompting. Rendering the film took a few hours. And it is only a concept. Not approved. Not built.",
   "map": null
  },
  {
   "id": "p9",
   "start": 68.404,
   "end": 76.193,
   "show": "This is what AI-assisted creation really looks like. Follow Agentoon.ai, for more real AI experiments.",
   "speak": "This is what AI-assisted creation really looks like. Follow Agentoon dot A I, for more real AI experiments.",
   "map": null
  }
 ],
