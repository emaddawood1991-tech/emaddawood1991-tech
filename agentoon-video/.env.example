# Agentoon.ai video production credentials. Copy to .env (git-ignored) and fill in locally.
# Never reuse Dawoud Labs keys. Never paste these values into chat.

# Optional paid provider: Vercel AI Gateway. Create a NEW key named "agentoon-video" in the
# Vercel dashboard (AI Gateway > API Keys) with a spend limit and an expiry.
AI_GATEWAY_API_KEY=

# Free stock footage: create a key at https://www.pexels.com/api/
PEXELS_API_KEY=
